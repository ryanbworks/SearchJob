# Copie para .env e ajuste. Todas as variáveis usam o prefixo SJ_.

# Chave que a extensão envia no cabeçalho X-API-Key. Gere uma longa e aleatória:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SJ_API_KEY=troque-por-uma-chave-aleatoria

# Termos pesquisados (JSON)
SJ_SEARCH_TERMS=["suporte tecnico", "help desk", "service desk", "analista de suporte", "tecnico de informatica"]

# Filtra por estado (vazio = todos). Vagas remotas sempre entram.
SJ_PREFERRED_STATES=[]

# Filtro de vagas ruins
# Títulos com estes termos são descartados (deixe comentado para usar o padrão:
# sênior, pleno, coordenador, gerente, especialista, supervisor, líder…)
# SJ_EXCLUDE_TITLE_TERMS=["senior", "sr", "pleno", "coordenador", "gerente"]
# Descarta a vaga se o termo aparecer no título ou na descrição
SJ_BLOCKED_TERMS=["comissao", "vendas externas", "telemarketing ativo"]
# Acima disso a vaga recebe um aviso e a IA reduz a nota
SJ_MAX_EXPERIENCE_YEARS=2

# IA local — escolha UMA opção:
# A) Ollama na CPU do servidor (docker compose --profile ollama up -d)
#    Em CPU, prefira um modelo pequeno: qwen2.5:3b-instruct (~2 GB de RAM).
#    Com 8 GB+ livres: qwen2.5:7b-instruct. Qwen3 tem o "pensamento" desligado automaticamente.
SJ_LLM_BASE_URL=http://ollama:11434/v1
SJ_LLM_MODEL=qwen2.5:3b-instruct
# B) LM Studio / llama.cpp (Vulkan) no PC com a RX 6600
# SJ_LLM_BASE_URL=http://192.168.0.10:1234/v1
# SJ_LLM_MODEL=qwen2.5-7b-instruct

# Agendamento
SJ_COLLECT_EVERY_HOURS=3
SJ_REPORT_HOUR=18
SJ_TIMEZONE=America/Sao_Paulo

# Alertas de vaga por e-mail + respostas das empresas (opcional, veja docs/alertas-email.md)
# Use um Gmail só para vagas, com verificação em 2 etapas e uma "senha de app".
SJ_IMAP_HOST=
SJ_IMAP_USER=
SJ_IMAP_PASSWORD=
SJ_IMAP_FOLDER=INBOX
SJ_IMAP_DAYS=7

# Telegram (opcional): crie um bot com o @BotFather
SJ_TELEGRAM_BOT_TOKEN=
SJ_TELEGRAM_CHAT_ID=
