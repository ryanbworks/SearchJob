# Copie para .env e ajuste. Todas as variáveis usam o prefixo SJ_.

# Chave que a extensão envia no cabeçalho X-API-Key. Gere uma longa e aleatória:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SJ_API_KEY=troque-por-uma-chave-aleatoria

# Termos pesquisados (JSON)
SJ_SEARCH_TERMS=["suporte tecnico", "help desk", "service desk", "analista de suporte", "tecnico de informatica"]

# Filtra por estado (vazio = todos). Vagas remotas sempre entram.
SJ_PREFERRED_STATES=[]

# IA local — escolha UMA opção:
# A) Ollama na CPU do servidor (docker compose --profile ollama up -d)
SJ_LLM_BASE_URL=http://ollama:11434/v1
SJ_LLM_MODEL=qwen2.5:7b-instruct
# B) LM Studio / llama.cpp (Vulkan) no PC com a RX 6600
# SJ_LLM_BASE_URL=http://192.168.0.10:1234/v1
# SJ_LLM_MODEL=qwen2.5-7b-instruct

# Agendamento
SJ_COLLECT_EVERY_HOURS=3
SJ_REPORT_HOUR=18
SJ_TIMEZONE=America/Sao_Paulo

# Telegram (opcional): crie um bot com o @BotFather
SJ_TELEGRAM_BOT_TOKEN=
SJ_TELEGRAM_CHAT_ID=
