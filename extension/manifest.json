{
  "manifest_version": 3,
  "name": "SearchJob Autofill",
  "version": "0.1.0",
  "description": "Preenche formulários de candidatura com o seu perfil e usa a IA local do SearchJob para responder perguntas abertas.",
  "homepage_url": "https://github.com/ryanbworks/SearchJob",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "SearchJob",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["lib/api.js", "background.js"]
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "searchjob-autofill@searchjob.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
